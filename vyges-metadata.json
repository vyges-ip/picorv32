  "interfaces": [
    {
      "type": "bus",
      "direction": "master",
      "protocol": "AXI4-Lite",
      "port": "axi_master",
      "width": 32,
      "description": "AXI4-Lite master interface for memory access (picorv32_axi variant; not used by Vyges TL-UL wrapper).",
      "signals": [
        {
          "name": "mem_axi_awvalid",
          "direction": "output",
          "type": "control",
          "width": 1,
          "description": "AXI4-Lite write address valid"
        },
        {
          "name": "mem_axi_awready",
          "direction": "input",
          "type": "control",
          "width": 1,
          "description": "AXI4-Lite write address ready"
        },
        {
          "name": "mem_axi_awaddr",
          "direction": "output",
          "type": "data",
          "width": 32,
          "description": "AXI4-Lite write address"
        },
        {
          "name": "mem_axi_wvalid",
          "direction": "output",
          "type": "control",
          "width": 1,
          "description": "AXI4-Lite write data valid"
        },
        {
          "name": "mem_axi_wready",
          "direction": "input",
          "type": "control",
          "width": 1,
          "description": "AXI4-Lite write data ready"
        },
        {
          "name": "mem_axi_wdata",
          "direction": "output",
          "type": "data",
          "width": 32,
          "description": "AXI4-Lite write data"
        },
        {
          "name": "mem_axi_wstrb",
          "direction": "output",
          "type": "control",
          "width": 4,
          "description": "AXI4-Lite write byte strobes"
        },
        {
          "name": "mem_axi_bvalid",
          "direction": "input",
          "type": "control",
          "width": 1,
          "description": "AXI4-Lite write response valid"
        },
        {
          "name": "mem_axi_bready",
          "direction": "output",
          "type": "control",
          "width": 1,
          "description": "AXI4-Lite write response ready"
        },
        {
          "name": "mem_axi_arvalid",
          "direction": "output",
          "type": "control",
          "width": 1,
          "description": "AXI4-Lite read address valid"
        },
        {
          "name": "mem_axi_arready",
          "direction": "input",
          "type": "control",
          "width": 1,
          "description": "AXI4-Lite read address ready"
        },
        {
          "name": "mem_axi_araddr",
          "direction": "output",
          "type": "data",
          "width": 32,
          "description": "AXI4-Lite read address"
