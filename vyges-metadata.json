        {
          "name": "mem_axi_rready",
          "direction": "output",
          "type": "control",
          "width": 1,
          "description": "AXI4-Lite read data ready"
        },
        {
          "name": "mem_axi_rdata",
          "direction": "input",
          "type": "data",
          "width": 32,
          "description": "AXI4-Lite read data"
        }
      ]
    },
    {
      "type": "bus",
      "direction": "master",
      "protocol": "Wishbone",
      "port": "wb_master",
      "width": 32,
      "description": "Wishbone master interface (picorv32_wb variant; not used by Vyges TL-UL wrapper).",
      "signals": [
        {
          "name": "wb_cyc_o",
          "direction": "output",
          "type": "control",
          "width": 1,
          "description": "Wishbone bus cycle"
        },
        {
          "name": "wb_stb_o",
          "direction": "output",
          "type": "control",
          "width": 1,
          "description": "Wishbone strobe"
        },
        {
          "name": "wb_we_o",
          "direction": "output",
          "type": "control",
          "width": 1,
          "description": "Wishbone write-enable"
        },
        {
          "name": "wb_adr_o",
          "direction": "output",
          "type": "data",
          "width": 32,
          "description": "Wishbone address"
        },
        {
          "name": "wb_dat_o",
          "direction": "output",
          "type": "data",
          "width": 32,
          "description": "Wishbone master-to-slave data"
        },
        {
          "name": "wb_sel_o",
          "direction": "output",
          "type": "control",
          "width": 4,
          "description": "Wishbone byte-select"
        },
        {
          "name": "wb_ack_i",
          "direction": "input",
          "type": "control",
          "width": 1,
          "description": "Wishbone slave acknowledge"
        },
        {
          "name": "wb_dat_i",
          "direction": "input",
          "type": "data",
          "width": 32,
          "description": "Wishbone slave-to-master data"
        }
      ]
    },
    {
      "type": "clock",
      "direction": "input",
      "protocol": "standard",
      "port": "clk",
      "width": 1,
      "description": "Clock input. Upstream picorv32 names this `clk`; the picorv32_tlul wrapper renames to `clk_i` per Vyges convention.",
      "signals": [
        {
          "name": "clk_i",
          "direction": "input",
          "type": "clock",
          "width": 1,
          "description": "System clock (single domain \u2014 same clock as all bus + peripheral logic)."
        }
      ]
    },
    {
      "type": "reset",
      "direction": "input",
      "protocol": "standard",
      "port": "resetn",
      "width": 1,
      "description": "Active-low reset. Upstream picorv32 names this `resetn`; the picorv32_tlul wrapper renames to `rst_ni` per Vyges convention.",
      "signals": [
        {
          "name": "rst_ni",
          "direction": "input",
          "type": "reset",
          "width": 1,
          "active_level": "low",
          "description": "Active-low synchronous reset (apply for \u22654 cycles)."
        }
      ]
    },
    {
      "type": "interrupt",
      "direction": "input",
      "protocol": "custom",
      "port": "irq",
      "width": 32,
      "description": "PicoRV32 native 32-bit IRQ vector. The Vyges wrapper exposes only one external IRQ port (irq_external_i, wired to irq[31]) and masks the rest via MASKED_IRQ.",
      "signals": [
        {
          "name": "irq_external_i",
          "direction": "input",
          "type": "interrupt",
          "width": 1,
          "description": "External interrupt input \u2014 wired to picorv32 irq[31] inside the wrapper. Driven by the PLIC's claimed-source line."
        }
      ]
    },
    {
      "type": "bus",
      "direction": "master",
      "protocol": "TL-UL",
      "port": "tl",
      "width": 32,
      "description": "TL-UL host port exposed by the picorv32_tlul wrapper. Bridges PicoRV32's native simple memory interface via tlul_adapter_host.",
      "signals": [
        {
          "name": "tl_o",
          "direction": "output",
          "type": "data",
          "width": 1,
          "description": "TL-UL host-to-device struct (tlul_pkg::tl_h2d_t)."
        },
        {
          "name": "tl_i",
          "direction": "input",
          "type": "data",
          "width": 1,
          "description": "TL-UL device-to-host struct (tlul_pkg::tl_d2h_t)."
        }
      ]
    }
